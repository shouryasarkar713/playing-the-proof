{
  "name": "playing-the-proof",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --project default",
    "test:watch": "vitest --project default",
    "test:slow": "vitest run --project slow",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "audit:replays": "vitest run --project default tests/replay/audit.test.ts",
    "coverage": "vitest run --project default --coverage --testTimeout=300000 && node scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "undici": "7.30.2"
  }
}
